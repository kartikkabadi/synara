# Provider API keys (any subset; providers without a key are skipped).
OPENAI_API_KEY=            # Codex (CODEX_API_KEY also accepted)
ANTHROPIC_API_KEY=         # Claude
XAI_API_KEY=               # Grok (GROK_CODE_XAI_API_KEY also accepted)
OPENCODE_API_KEY=          # OpenCode / Kilo (OPENCODE_GO_API_KEY also accepted)
PI_API_KEY=                # Pi

# Options
# Comma-separated providers to test: codex,claudeAgent,grok,opencode,kilo,pi,cursor,droid,antigravity
SYNARA_E2E_PROVIDERS=
# Set to 0 to watch the browser.
SYNARA_E2E_HEADLESS=
# Absolute path to a workspace to open instead of the auto-created scratch repo.
SYNARA_E2E_WORKSPACE=
# Port overrides (defaults: server 3899, web 5899).
SYNARA_E2E_PORT=
SYNARA_E2E_WEB_PORT=
