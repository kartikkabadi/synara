--- /dev/null
+++ b/dist/src/helium-cookie-source.js
@@ -0,0 +1,348 @@
+// Helium (net.imput.helium) cookie source for hosts whose native reader does
+// not register the browser yet. Reads the same Chromium cookie database the
+// native reader would, decrypts v10 rows with the profile's Keychain secret,
+// and emits the same detailed-cookie snapshot shape as the native reader so
+// the regular Cookie Sync transfer pipeline stays in charge.
+import { execFile } from "node:child_process";
+import { createDecipheriv, createHash, pbkdf2Sync, timingSafeEqual } from "node:crypto";
+import { mkdtemp, readdir, rm, stat } from "node:fs/promises";
+import { homedir, tmpdir } from "node:os";
+import { join } from "node:path";
+import { DatabaseSync } from "node:sqlite";
+
+const HELIUM_BROWSER_ID = "helium";
+const HELIUM_DATA_DIR = "net.imput.helium";
+const HELIUM_KEYCHAIN_SERVICE = "Helium Storage Key";
+const HELIUM_KEYCHAIN_ACCOUNT = "Helium";
+const HELIUM_PROFILE_NAME_PATTERN = /^[A-Za-z0-9][A-Za-z0-9 _-]{0,127}$/;
+const HELIUM_RESERVED_PROFILE_DIRS = new Set([
+    "BrowserMetrics-spare.pma",
+    "CertificateRevocation",
+    "ChromeFeatureState",
+    "Crashpad",
+    "GPUPersistentCache",
+    "GraphiteDawnCache",
+    "GrShaderCache",
+    "ShaderCache",
+    "Snapshots",
+    "System Profile",
+    "component_crx_cache",
+    "extensions_crx_cache",
+]);
+const CHROMIUM_EPOCH_OFFSET_SECONDS = 11_644_473_600;
+const CHROMIUM_AES_IV = Buffer.alloc(16, 0x20);
+const HELIUM_KEYCHAIN_TIMEOUT_MS = 30_000;
+// Acquisition has its own larger ceiling so domain-filtered transfers can
+// select from profiles above the final 10,000-cookie / 6 MiB transfer limit.
+const HELIUM_SOURCE_MAX_ROWS = 100_000;
+const HELIUM_SNAPSHOT_MAX_BYTES = 64 * 1024 * 1024;
+
+export async function heliumCookieSourceAvailable(home = homedir()) {
+    if (process.platform !== "darwin") return null;
+    try {
+        if (!(await stat(heliumProfileRoot(home))).isDirectory()) return null;
+    } catch {
+        return null;
+    }
+    return { id: HELIUM_BROWSER_ID, name: "Helium", engine: "chromium" };
+}
+
+function heliumProfileRoot(home = homedir()) {
+    return join(home, "Library", "Application Support", HELIUM_DATA_DIR);
+}
+
+function heliumError(code, stage, permissionDenied = false) {
+    const error = new Error("Cookie Sync could not read the selected Helium profile.");
+    error.cookieReaderCode = code;
+    if (stage) error.cookieReaderStage = stage;
+    error.cookiePermissionDenied = permissionDenied === true;
+    return error;
+}
+
+function isMissingError(error) {
+    return error instanceof Error && (error.code === "ENOENT" || error.code === "ENAMETOOLONG");
+}
+
+function isPermissionError(error) {
+    if (!(error instanceof Error)) return false;
+    if (error.code === "EACCES" || error.code === "EPERM") return true;
+    const message = String(error.message);
+    return /\b(?:permission denied|operation not permitted|eacces|eperm|os error (?:1|13))\b/i.test(message);
+}
+
+// Every failure while opening, snapshotting, or querying the SQLite store is
+// reported through the bounded reader contract: a fixed message, the failing
+// stage, and explicit permission markers only, never the raw diagnostic,
+// which can carry filesystem paths or parser internals.
+function classifySqliteError(error, stage) {
+    if (error instanceof Error && typeof error.cookieReaderCode === "string") return error;
+    const message = error instanceof Error ? String(error.message) : "";
+    const permissionDenied = /\b(?:permission denied|operation not permitted|eacces|eperm|os error (?:1|13))\b/i.test(message);
+    return heliumError("source_extraction_failed", stage, permissionDenied);
+}
+
+function queryHeliumRows(database, sql) {
+    try {
+        return database.prepare(sql).all();
+    } catch (error) {
+        throw classifySqliteError(error, "query");
+    }
+}
+
+async function heliumCookieDatabasePath(profileDir) {
+    // Helium writes the legacy per-profile Cookies file today; probe it first so
+    // a future Network/Cookies layout never shadows the active legacy store.
+    for (const candidate of [join(profileDir, "Cookies"), join(profileDir, "Network", "Cookies")]) {
+        try {
+            if ((await stat(candidate)).isFile()) return candidate;
+        } catch (error) {
+            if (isMissingError(error)) continue;
+            throw heliumError("source_extraction_failed", "acquisition", isPermissionError(error));
+        }
+    }
+    return null;
+}
+
+export async function listHeliumProfiles(home = homedir()) {
+    if (process.platform !== "darwin") return [];
+    let entries;
+    try {
+        entries = await readdir(heliumProfileRoot(home), { withFileTypes: true });
+    } catch (error) {
+        if (isMissingError(error)) return [];
+        throw heliumError("discovery_failed", "discovery", isPermissionError(error));
+    }
+    const profiles = [];
+    for (const entry of entries) {
+        if (!entry.isDirectory() || !HELIUM_PROFILE_NAME_PATTERN.test(entry.name)) continue;
+        if (HELIUM_RESERVED_PROFILE_DIRS.has(entry.name)) continue;
+        if (await heliumCookieDatabasePath(join(heliumProfileRoot(home), entry.name)) === null) continue;
+        profiles.push({ id: entry.name, name: entry.name, isDefault: entry.name === "Default" });
+    }
+    return profiles.sort((left, right) => (right.isDefault ? 1 : 0) - (left.isDefault ? 1 : 0) || left.id.localeCompare(right.id));
+}
+
+export function keychainFailure(cause) {
+    // Never include tool output in the error: it may carry prompt text.
+    const message = String(cause?.message || "");
+    if (cause?.killed === true || /timed out/i.test(message)) return heliumError("timed_out", "decrypt");
+    if (/\bcancel+ed\b|interaction|auth/i.test(message)) return heliumError("source_extraction_failed", "decrypt", true);
+    return heliumError("source_extraction_failed", "decrypt");
+}
+
+function spawnKeychainPassword(timeoutMs) {
+    return new Promise((resolve, reject) => {
+        execFile(
+            "/usr/bin/security",
+            ["find-generic-password", "-w", "-a", HELIUM_KEYCHAIN_ACCOUNT, "-s", HELIUM_KEYCHAIN_SERVICE],
+            { timeout: Math.max(1_000, Math.min(timeoutMs, HELIUM_KEYCHAIN_TIMEOUT_MS)), maxBuffer: 4_096, windowsHide: true },
+            (error, stdout) => {
+                if (!error) {
+                    const password = String(stdout).replace(/\r?\n$/, "");
+                    if (password) {
+                        resolve(password);
+                        return;
+                    }
+                    reject(heliumError("reader_failed", "decrypt"));
+                    return;
+                }
+                reject(keychainFailure(error));
+            },
+        );
+    });
+}
+
+function decryptChromiumValue(encrypted, key, version, hostKey) {
+    if (!(encrypted instanceof Uint8Array) || encrypted.length <= 3) return null;
+    const blob = Buffer.from(encrypted.buffer, encrypted.byteOffset, encrypted.byteLength);
+    const tag = blob.toString("latin1", 0, 3);
+    // v10 is the only macOS Chromium format: AES-128-CBC under the profile's
+    // Keychain key. v11 is a Linux keyring variant with no verified infix
+    // layout and never appears on darwin; such rows fail closed as
+    // decrypt_failed instead of trusting an invented format.
+    if (tag !== "v10") return null;
+    const body = blob.subarray(3);
+    try {
+        const decipher = createDecipheriv("aes-128-cbc", key, CHROMIUM_AES_IV);
+        let plain = Buffer.concat([decipher.update(body), decipher.final()]);
+        if (version >= 24) {
+            // Chromium's load path verifies SHA256(host_key) before stripping
+            // the digest prefix (kHashFailed on mismatch). Require the exact
+            // match so a wrong-key decrypt that survives PKCS7 unpadding, or
+            // a corrupted ciphertext, fails closed as decrypt_failed instead
+            // of producing a silently corrupted cookie value.
+            if (plain.length < 32) return null;
+            const digest = createHash("sha256").update(hostKey ?? "").digest();
+            if (!timingSafeEqual(plain.subarray(0, 32), digest)) return null;
+            plain = plain.subarray(32);
+        }
+        return plain.length ? plain.toString("utf8") : "";
+    } catch {
+        return null;
+    }
+}
+
+function heliumCookieRow(row, key, warnings, version) {
+    const name = typeof row.name === "string" ? row.name : "";
+    const domain = typeof row.host_key === "string" ? row.host_key.trim().toLowerCase() : "";
+    const path = typeof row.path === "string" ? row.path : "";
+    if (!name || !domain || !path.startsWith("/")) {
+        warnings.set("malformed", (warnings.get("malformed") ?? 0) + 1);
+        return null;
+    }
+    let value = typeof row.value === "string" ? row.value : "";
+    if (!value) {
+        value = decryptChromiumValue(row.encrypted_value, key, version, typeof row.host_key === "string" ? row.host_key : "");
+        if (value === null) {
+            warnings.set("decrypt_failed", (warnings.get("decrypt_failed") ?? 0) + 1);
+            return null;
+        }
+    }
+    // readBigInts surfaces every INTEGER column as bigint; widen the small ones.
+    const secure = Number(row.is_secure);
+    const httpOnly = Number(row.is_httponly);
+    const sameSite = Number(row.samesite);
+    const cookie = {
+        name,
+        value,
+        domain,
+        path,
+        secure: secure === 1,
+        httpOnly: httpOnly === 1,
+        sameSite: sameSite >= -1 && sameSite <= 2 ? sameSite : -1,
+    };
+    if (Number(row.has_expires) === 1 && typeof row.expires_utc === "bigint" && row.expires_utc > 0n) {
+        cookie.expires = Number(row.expires_utc / 1_000_000n) - CHROMIUM_EPOCH_OFFSET_SECONDS;
+    }
+    const context = {};
+    const sourceScheme = Number(row.source_scheme);
+    if (sourceScheme === 0 || sourceScheme === 1 || sourceScheme === 2) {
+        context.sourceScheme = sourceScheme;
+    }
+    const sourcePort = Number(row.source_port);
+    if (sourcePort === -1 || (sourcePort >= 1 && sourcePort <= 65_535)) {
+        context.sourcePort = sourcePort;
+    }
+    const topFrameSiteKey = typeof row.top_frame_site_key === "string" ? row.top_frame_site_key : "";
+    if (topFrameSiteKey) {
+        const hasCrossSiteAncestor = row.has_cross_site_ancestor;
+        const isCrossSite = hasCrossSiteAncestor !== undefined
+            ? Number(hasCrossSiteAncestor) === 1
+            : false;
+        context.topFrameSiteKey = topFrameSiteKey;
+        context.hasCrossSiteAncestor = isCrossSite;
+    }
+    return { cookie, context };
+}
+
+async function snapshotHeliumDatabase(databasePath, workspace) {
+    // VACUUM INTO takes one consistent snapshot under a read transaction, so a
+    // live Helium write can never be observed as a torn database + WAL pair.
+    let database;
+    try {
+        database = new DatabaseSync(databasePath, { readOnly: true });
+    } catch (error) {
+        throw classifySqliteError(error, "acquisition");
+    }
+    try {
+        const copyPath = join(workspace, "Cookies");
+        database.exec(`VACUUM INTO '${copyPath.replaceAll("'", "''")}'`);
+        return copyPath;
+    } catch (error) {
+        throw classifySqliteError(error, "acquisition");
+    } finally {
+        database.close();
+    }
+}
+
+async function queryHeliumCookies(databasePath, key, warnings) {
+    let database;
+    try {
+        database = new DatabaseSync(databasePath, { readBigInts: true });
+    } catch (error) {
+        throw classifySqliteError(error, "acquisition");
+    }
+    try {
+        const columns = new Set(
+            queryHeliumRows(database, "PRAGMA table_info(cookies)").map((column) => String(column.name)),
+        );
+        const secure = columns.has("is_secure") ? "is_secure" : "secure";
+        const httpOnly = columns.has("is_httponly") ? "is_httponly" : "httponly";
+        const topFrameSiteKey = columns.has("top_frame_site_key") ? "top_frame_site_key" : null;
+        const hasCrossSiteAncestor = columns.has("has_cross_site_ancestor") ? "has_cross_site_ancestor" : null;
+        const selection = [
+            "host_key",
+            "name",
+            "value",
+            "encrypted_value",
+            "path",
+            secure,
+            httpOnly,
+            "samesite",
+            "expires_utc",
+            "has_expires",
+            ...(columns.has("source_scheme") ? ["source_scheme"] : []),
+            ...(columns.has("source_port") ? ["source_port"] : []),
+            ...(topFrameSiteKey ? [topFrameSiteKey] : []),
+            ...(hasCrossSiteAncestor ? [hasCrossSiteAncestor] : []),
+        ].filter(Boolean);
+        let version = 0;
+        try {
+            const meta = database.prepare("SELECT value FROM meta WHERE key = 'version'").get();
+            if (meta) {
+                // Real Helium databases store meta.value as INTEGER, which
+                // readBigInts surfaces as bigint; legacy and synthetic stores
+                // keep the string form.
+                const parsed = typeof meta.value === "bigint" || typeof meta.value === "number"
+                    ? Number(meta.value)
+                    : Number.parseInt(String(meta.value), 10);
+                if (Number.isInteger(parsed) && parsed >= 0) version = parsed;
+            }
+        } catch { /* The meta table is best-effort. */ }
+        const rows = queryHeliumRows(database, `SELECT ${selection.join(", ")} FROM cookies LIMIT ${HELIUM_SOURCE_MAX_ROWS + 1}`);
+        if (rows.length > HELIUM_SOURCE_MAX_ROWS) throw heliumError("source_extraction_failed", "query");
+        const detailedCookies = [];
+        for (const row of rows) {
+            const detailed = heliumCookieRow(row, key, warnings, version);
+            if (detailed) detailedCookies.push(detailed);
+        }
+        return detailedCookies;
+    } finally {
+        database.close();
+    }
+}
+
+export async function readHeliumCookieSnapshot(options, deps = {}) {
+    if (process.platform !== "darwin") throw heliumError("no_discovered_source", "discovery");
+    const profile = typeof options.source.profile === "string" ? options.source.profile.trim() : "";
+    if (!profile || !HELIUM_PROFILE_NAME_PATTERN.test(profile)) throw heliumError("no_selected_source", "discovery");
+    const home = deps.home ?? homedir();
+    const listProfiles = deps.listProfiles ?? (() => listHeliumProfiles(home));
+    const available = await listProfiles();
+    if (!available.some((entry) => entry.id === profile)) throw heliumError("no_selected_source", "discovery");
+    const databasePath = await heliumCookieDatabasePath(join(heliumProfileRoot(home), profile));
+    if (!databasePath) throw heliumError("no_selected_source", "acquisition");
+    if ((await stat(databasePath)).size > HELIUM_SNAPSHOT_MAX_BYTES) throw heliumError("source_extraction_failed", "acquisition");
+    const workspace = await mkdtemp(join(tmpdir(), "betterwright-helium-"));
+    try {
+        const copyPath = await snapshotHeliumDatabase(databasePath, workspace);
+        if ((await stat(copyPath)).size > HELIUM_SNAPSHOT_MAX_BYTES) throw heliumError("source_extraction_failed", "acquisition");
+        const keychainPassword = deps.keychainPassword ?? spawnKeychainPassword;
+        const password = await keychainPassword(Math.min(options.timeoutMs, HELIUM_KEYCHAIN_TIMEOUT_MS));
+        if (!password) throw heliumError("source_extraction_failed", "decrypt");
+        const key = pbkdf2Sync(password, "saltysalt", 1003, 16, "sha1");
+        try {
+            const warnings = new Map();
+            const detailedCookies = await queryHeliumCookies(copyPath, key, warnings);
+            return {
+                detailedCookies,
+                warnings: [...warnings.entries()].map(([code, count]) => ({ code, count })),
+            };
+        } finally {
+            key.fill(0);
+        }
+    } finally {
+        await rm(workspace, { recursive: true, force: true }).catch(() => {});
+    }
+
+}
